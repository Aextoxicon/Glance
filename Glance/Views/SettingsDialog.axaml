<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Glance.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Glance.Views.SettingsDialog"
             x:DataType="vm:MainViewModel">
  <StackPanel Spacing="14">
    <StackPanel Spacing="6">
      <TextBlock Text="主题" />
      <StackPanel Orientation="Horizontal" Spacing="16">
        <RadioButton x:Name="RbLight" Content="浅色" IsCheckedChanged="OnThemeChecked" />
        <RadioButton x:Name="RbDark" Content="深色" IsCheckedChanged="OnThemeChecked" />
        <RadioButton x:Name="RbSystem" Content="跟随系统" IsCheckedChanged="OnThemeChecked" />
      </StackPanel>
    </StackPanel>
    <StackPanel Spacing="6">
      <TextBlock Text="代码字号" />
      <ComboBox ItemsSource="{x:Static vm:MainViewModel.CodeFontSizes}"
                SelectedItem="{Binding CodeFontSize}"
                HorizontalAlignment="Left" MinWidth="100" />
    </StackPanel>
    <CheckBox Content="记住上次打开的目录" IsChecked="{Binding RememberLastDir}" />
    <CheckBox Content="显示行号" IsChecked="{Binding ShowLineNumbers}" />
    <StackPanel Spacing="6">
      <TextBlock Text="诊断" />
      <CheckBox Content="启用诊断追踪（环形缓冲，release 亦可产日志）" IsChecked="{Binding TraceEnabled}" />
      <Button Content="导出日志" HorizontalAlignment="Left" Click="OnExportTrace" />
    </StackPanel>
    <Button Content="关闭" HorizontalAlignment="Right" Click="OnClose" />
  </StackPanel>
</UserControl>
