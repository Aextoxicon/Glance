<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Glance.ViewModels"
             xmlns:native="using:Glance.Native"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:views="using:Glance.Views"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="Glance.Views.MainView"
             x:DataType="vm:MainViewModel">
  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <UserControl.Styles>
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
  </UserControl.Styles>

  <UserControl.Resources>
    <SolidColorBrush x:Key="TreeSelectionBackground" Color="{DynamicResource SystemAccentColor}" Opacity="0.22" />
    <SolidColorBrush x:Key="TreeSelectionBackgroundStrong" Color="{DynamicResource SystemAccentColor}" Opacity="0.32" />
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="260,*,220" x:Name="RootGrid">
    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="6" Spacing="4">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button x:Name="DrawerToggle" Click="OnToggleTreeDrawer" IsVisible="{Binding !IsWide}"
                ToolTip.Tip="文件树">
          <Path Width="18" Height="18" Stretch="Uniform"
                Stroke="{DynamicResource SystemControlForegroundBaseHighBrush}"
                StrokeThickness="2" Data="M3 6h18M3 12h18M3 18h18" />
        </Button>
        <Button Content="打开文件夹" Click="OnOpenFolder" />
        <Button Content="关闭工作区" Click="OnCloseWorkspace" IsVisible="{Binding HasWorkspace}" />
        <Button Content="全展开" Click="OnExpandAll" />
        <Button Content="全折叠" Click="OnCollapseAll" />
        <Button Content="刷新" Click="OnRefresh" />
        <Button Content="设置" Click="OnOpenSettings" />
        <TextBlock Text="{Binding CurrentFolderName}" VerticalAlignment="Center" Margin="8,0,0,0" />
        <TextBlock Text="{Binding TotalSizeReadable}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding SelectedArtifact.Name}" IsVisible="{Binding ShowNarrowFileName}"
                   VerticalAlignment="Center" Margin="8,0,0,0"
                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="240" />
      </StackPanel>
      <ProgressBar IsIndeterminate="True"
                   IsVisible="{Binding IsComputingSize}"
                   Height="3"
                   Margin="0,2,0,0" />
    </StackPanel>

    <Border Grid.Row="1" Grid.Column="0" x:Name="TreeColumnHost" Padding="2">
      <TreeView x:Name="FileTree"
                ItemsSource="{Binding TreeItems}"
                SelectionChanged="OnTreeSelectionChanged">
        <TreeView.Styles>
          <Style Selector="TreeViewItem" x:DataType="vm:TreeItemViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          </Style>
          <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource TreeSelectionBackground}" />
          </Style>
          <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot:pointerover">
            <Setter Property="Background" Value="{DynamicResource TreeSelectionBackgroundStrong}" />
          </Style>
          <Style Selector="TreeViewItem:pressed:selected /template/ Border#PART_LayoutRoot:pointerover">
            <Setter Property="Background" Value="{DynamicResource TreeSelectionBackgroundStrong}" />
          </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
          <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:TreeItemViewModel">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <materialIcons:MaterialIcon Kind="{Binding IconKind}" Width="16" Height="16" VerticalAlignment="Center"
                            Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" />
              <TextBlock Text="{Binding Artifact.Name}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding SizeDisplay}" FontSize="11"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            </StackPanel>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
        </TreeView>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" IsVisible="{Binding IsTreeEmpty}"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            ZIndex="5">
      <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="空目录" IsVisible="{Binding !TreeLoadMessage}"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        <TextBlock Text="{Binding TreeLoadMessage}" IsVisible="{Binding TreeLoadMessage}"
                   TextWrapping="Wrap" Margin="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*">
      <Border Grid.Row="0" IsVisible="{Binding HasSelection}"
              Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              BorderThickness="0,0,0,1" Padding="6">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                     ToolTip.Tip="{Binding SelectedArtifact.Name}">
            <TextBlock Text="{Binding SelectedArtifact.Name}" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" MaxWidth="420" />
            <TextBlock Text="{Binding SelectedSizeDisplay}"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                       VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
            <Button Content="大纲" Click="OnToggleOutline" IsVisible="{Binding HasOutline}"
                    FontSize="11" Padding="6,2" />
            <Button Content="关闭" Click="OnClosePreview" FontSize="11" Padding="6,2" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <ae:TextEditor x:Name="PreviewEditor"
                       ShowLineNumbers="{Binding ShowLineNumbers}"
                       IsReadOnly="True"
                       FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
                       FontSize="{Binding CodeFontSize}"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto" />
        <ProgressBar IsIndeterminate="True"
                     IsVisible="{Binding IsLoadingPreview}"
                     Height="3"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Top"
                     ZIndex="20" />
        <Border IsVisible="{Binding !HasSelection}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                ZIndex="10">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <Path Width="48" Height="48" Stretch="Uniform"
                  Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                  Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" />
            <TextBlock Text="选择文件以预览"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
          </StackPanel>
        </Border>
        <Border IsVisible="{Binding HasPreviewNotice}"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                Padding="8" VerticalAlignment="Bottom">
          <TextBlock Text="{Binding PreviewNotice}" />
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="1" Grid.Column="2" x:Name="OutlineColumnHost" Margin="4">
      <Grid x:Name="OutlineContent" RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
          <TextBlock Text="大纲" FontWeight="Bold" VerticalAlignment="Center" />
          <Button Content="收起" Click="OnCloseOutline" FontSize="11" Padding="6,2" />
        </StackPanel>
        <ListBox Grid.Row="1" x:Name="OutlineList"
                 ItemsSource="{Binding OutlineRows}"
                 SelectionChanged="OnOutlineSelectionChanged"
                 IsVisible="{Binding HasOutline}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:OutlineRow">
              <StackPanel Margin="{Binding Indent}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                          Padding="4,1" CornerRadius="3">
                    <TextBlock Text="{Binding KindLabel}" FontSize="11" />
                  </Border>
                  <TextBlock Text="{Binding DisplayName}" />
                </StackPanel>
                <TextBlock Text="{Binding Node.Detail}" FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="1" Text="该文件没有大纲"
                   IsVisible="{Binding OutlineEmpty}"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      </Grid>
    </Border>

    <Border Grid.Row="2" Grid.ColumnSpan="3" Padding="6"
            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
      <TextBlock Text="{Binding MessageText}"
                 Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
    </Border>

    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
          x:Name="TreeDrawer" IsVisible="False" ZIndex="40">
      <Border x:Name="TreeDrawerScrim" Background="#80000000" PointerPressed="OnTreeDrawerScrimPressed">
        <Border.Styles>
          <Style Selector="Border">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
              </Transitions>
            </Setter>
          </Style>
        </Border.Styles>
      </Border>
      <Border x:Name="TreeDrawerPanel"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              BorderThickness="0,0,1,0" Width="280"
              HorizontalAlignment="Left">
        <Border.Styles>
          <Style Selector="Border">
            <Setter Property="RenderTransform" Value="translateX(-280px)" />
            <Setter Property="Transitions">
              <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" />
              </Transitions>
            </Setter>
          </Style>
          <Style Selector="Border.open">
            <Setter Property="RenderTransform" Value="translateX(0px)" />
          </Style>
        </Border.Styles>
      </Border>
    </Grid>

    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
          x:Name="OutlineDrawer" IsVisible="False" ZIndex="40">
      <Border x:Name="OutlineDrawerScrim" Background="#80000000" PointerPressed="OnOutlineDrawerScrimPressed">
        <Border.Styles>
          <Style Selector="Border">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
              </Transitions>
            </Setter>
          </Style>
        </Border.Styles>
      </Border>
      <Border x:Name="OutlineDrawerPanel"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              BorderThickness="1,0,0,0" Width="240"
              HorizontalAlignment="Right">
        <Border.Styles>
          <Style Selector="Border">
            <Setter Property="RenderTransform" Value="translateX(240px)" />
            <Setter Property="Transitions">
              <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" />
              </Transitions>
            </Setter>
          </Style>
          <Style Selector="Border.open">
            <Setter Property="RenderTransform" Value="translateX(0px)" />
          </Style>
        </Border.Styles>
      </Border>
    </Grid>

    <Grid Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3"
          x:Name="WelcomePanel" IsVisible="{Binding !HasWorkspace}"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
          ZIndex="50">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
        <Path Width="96" Height="96" Stretch="Uniform"
              Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" />
        <TextBlock Text="Glance" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock Text="选择一个文件夹开始预览代码"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        <Button Content="打开文件夹" Click="OnOpenFolder"
                HorizontalAlignment="Center" Padding="24,10" FontSize="15" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3"
          x:Name="SettingsOverlay" IsVisible="False"
          Background="#80000000" ZIndex="100"
          PointerPressed="OnSettingsOverlayPointerPressed">
      <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
              BorderThickness="1" CornerRadius="8" Padding="16"
              Width="340" MaxWidth="380"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <views:SettingsDialog x:Name="SettingsPanel" CloseRequested="OnSettingsClose" />
      </Border>
    </Grid>
  </Grid>
</UserControl>
