<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Glance"
             x:Class="Glance.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <!-- AvaloniaEdit's theme is wired in code-behind (App.Initialize) because AvaloniaEdit
             ships no Android TFM and must not be referenced from the Android build. -->
    </Application.Styles>
</Application>