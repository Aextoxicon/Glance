<Project>

  <!-- Custom build workflow.
       Invoke:  dotnet build Glance.Desktop/Glance.Desktop.csproj /t:BuildAll
       Builds Glance.Desktop + Glance.Android (Release) and copies the distributable
       artifacts to the Desktop/Glance folder.
       Override defaults:
         /p:BuildAllConfig=Debug
         /p:BuildAllDest=/tmp/Glance
         /p:BuildAllJdk=/path/to/jdk21
       JAVA_HOME for the Android build defaults to the Gradle-managed JDK 21. -->

  <PropertyGroup>
    <BuildAllConfig Condition="'$(BuildAllConfig)' == ''">Release</BuildAllConfig>

    <!-- Home directory differs by platform -->
    <HomeDir Condition="'$(OS)' == 'Windows_NT'">$([System.Environment]::GetEnvironmentVariable('USERPROFILE'))</HomeDir>
    <HomeDir Condition="'$(OS)' != 'Windows_NT'">$([System.Environment]::GetEnvironmentVariable('HOME'))</HomeDir>

    <BuildAllDest Condition="'$(BuildAllDest)' == ''">$(HomeDir)/Desktop/Glance</BuildAllDest>
    <BuildAllJdk Condition="'$(BuildAllJdk)' == ''">$(HomeDir)/.gradle/jdks/microsoft-21-amd64-windows.2</BuildAllJdk>
  </PropertyGroup>

  <Target Name="BuildAll">
    <Message Text="BuildAll: config=$(BuildAllConfig) dest=$(BuildAllDest) jdk=$(BuildAllJdk)" Importance="high" />

    <RemoveDir Directories="$(BuildAllDest)/Desktop" Condition="Exists('$(BuildAllDest)/Desktop')" />

    <Exec Command="dotnet publish Glance.Desktop/Glance.Desktop.csproj -c $(BuildAllConfig) -r win-x64 --self-contained -p:PublishAot=true -p:PublishDir=$(BuildAllDest)/Desktop/ --nologo"
          WorkingDirectory="$(MSBuildThisFileDirectory)" />

    <Copy SourceFiles="$(MSBuildThisFileDirectory)native/target/release/uniffi_code_parser.dll"
          DestinationFiles="$(BuildAllDest)/Desktop/uniffi_code_parser.dll"
          Condition="Exists('$(MSBuildThisFileDirectory)native/target/release/uniffi_code_parser.dll')" />
    <Warning Text="BuildAll: native lib missing at $(MSBuildThisFileDirectory)native/target/release/uniffi_code_parser.dll; run 'cargo build --release' in native/ first."
          Condition="!Exists('$(MSBuildThisFileDirectory)native/target/release/uniffi_code_parser.dll')" />

    <Exec Command="dotnet build Glance.Android/Glance.Android.csproj -c $(BuildAllConfig) --nologo"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          EnvironmentVariables="JAVA_HOME=$(BuildAllJdk)" />

    <ItemGroup>
      <_AndroidApk Include="$(MSBuildThisFileDirectory)Glance.Android/bin/$(BuildAllConfig)/net10.0-android/*.apk" />
    </ItemGroup>
    <MakeDir Directories="$(BuildAllDest)/Android" />
    <Copy SourceFiles="@(_AndroidApk)"
          DestinationFolder="$(BuildAllDest)/Android"
          SkipUnchangedFiles="true" />

    <Message Text="BuildAll complete -> $(BuildAllDest)" Importance="high" />
  </Target>

</Project>
